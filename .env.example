# InsForge — panel admin + datos de casas
NUXT_PUBLIC_INSFORGE_URL=https://YOUR_APPKEY.REGION.insforge.app
NUXT_PUBLIC_INSFORGE_ANON_KEY=anon_xxxxxxxx
# Solo servidor (subida de fotos admin). Nunca NUXT_PUBLIC_
INSFORGE_API_KEY=ik_xxxxxxxx

# Email notifications (Resend) — opcional
# RESEND_API_KEY=re_xxxxxxxx
# ADMIN_NOTIFY_EMAIL=info@hellogroup.com

# Google Maps Embed API — opcional (ficha de cada casa)
# NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
